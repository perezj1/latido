{
  "functions": { "api/card-share.js": { "includeFiles": "dist/index.html" } },
  "headers": [
    {
      "source": "/downloads/aleman-con-n/guia-primer-trabajo-suiza.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"guia-aleman-primer-trabajo-suiza.pdf\"" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/card/validacion/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/card/scanner/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/scanner/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/c/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/publicar/punto-hispano/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ],
  "redirects": [
    { "source": "/tarjeta-latido", "destination": "/club", "permanent": true }
  ],
  "rewrites": [
    { "source": "/card/negocio/:provider", "destination": "/api/card-share?provider=:provider" },
    { "source": "/card", "destination": "/api/card-share" },
    { "source": "/scanner", "destination": "/scanner/index.html" },
    { "source": "/scanner/", "destination": "/scanner/index.html" },
    { "source": "/scanner/link/:token", "destination": "/scanner/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
