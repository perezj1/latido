{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Preguntas de Suizamente",
  "type": "object",
  "required": ["version", "temas", "preguntas"],
  "properties": {
    "version": { "type": "integer" },
    "nombre": { "type": "string" },
    "descripcion": { "type": "string" },
    "temas": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "preguntas": { "type": "array", "items": { "$ref": "#/$defs/pregunta" } }
  },
  "$defs": {
    "opcion": {
      "type": "object",
      "required": ["e", "t"],
      "additionalProperties": false,
      "properties": {
        "e": { "type": "string", "minLength": 1, "maxLength": 16, "description": "Emoji" },
        "t": { "type": "string", "minLength": 1, "maxLength": 90 }
      }
    },
    "pregunta": {
      "type": "object",
      "required": ["id", "tipo", "tema", "emoji", "pregunta", "opciones", "dato"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 60, "description": "Único y permanente" },
        "tipo": { "enum": ["dilema", "real"] },
        "tema": { "enum": ["comida", "casa", "papeles", "trabajo", "dinero", "salud", "transporte", "idioma", "social", "fiestas", "naturaleza", "cultura"] },
        "emoji": { "type": "string", "minLength": 1, "maxLength": 16 },
        "pregunta": { "type": "string", "minLength": 5, "maxLength": 140 },
        "opciones": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/$defs/opcion" } },
        "correcta": { "type": "integer", "minimum": 0, "maximum": 2, "description": "Solo en tipo real" },
        "dato": { "type": "string", "minLength": 20, "maxLength": 300 }
      },
      "if": { "properties": { "tipo": { "const": "real" } } },
      "then": { "required": ["correcta"] },
      "else": { "not": { "required": ["correcta"] } }
    }
  }
}
