# Copia como .env.local con tus credenciales de Supabase
# Supabase Dashboard → Settings → API

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
VITE_VAPID_PUBLIC_KEY=tu-vapid-public-key-aqui

# Supabase Edge Function secrets (no los expongas en Vite/Vercel como VITE_*)
# VAPID_PUBLIC_KEY=tu-vapid-public-key-aqui
# VAPID_PRIVATE_KEY=tu-vapid-private-key-aqui
# VAPID_SUBJECT=mailto:hola@latido.ch
# PUSH_WEBHOOK_SECRET=un-string-largo-y-secreto

# Delayed message emails via the normal Nominalia mailbox included with the domain
# SMTP_HOSTNAME=authsmtp.securemail.pro
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USERNAME=notificaciones@latido.ch
# SMTP_PASSWORD=password-del-buzon
# SMTP_FROM=Latido <notificaciones@latido.ch>
# LATIDO_APP_URL=https://www.latido.ch
# EMAIL_CRON_SECRET=otro-string-largo-y-secreto
# EMAIL_MAX_BATCH=25

# Eventfrog
EVENTFROG_API_KEY=tu-public-api-key-aqui
# Opcional: solo si tienes la clave del widget iframe de Eventfrog.
VITE_EVENTFROG_EMBED_KEY=tu-embed-key-aqui

# Latido Club / Gelato (solo servidor: nunca uses el prefijo VITE_)
# Crea la clave en el API Portal de Gelato. Usa una clave Sandbox para probar.
GELATO_API_KEY=tu-clave-secreta-de-gelato
# Opcional: evita buscar la tienda por nombre en cada arranque del servidor.
# GELATO_STORE_ID=tu-store-id-de-gelato
# GELATO_STORE_NAME=Latido Club
# Opcional: sobrescribe el catálogo incluido en api/gelatoCatalog.js sin tocar
# código. Cada SKU debe apuntar a un productUid y a un archivo HTTPS público.
# GELATO_PRODUCT_CATALOG_JSON={"mi-sku":{"productUid":"product_uid_de_gelato","fileUrl":"https://www.latido.ch/club/prints/mi-diseno.png"}}

# Checkout de Latido Club. Los precios publicados ya incluyen el envío a Suiza.
# Supabase secrets: STRIPE_CLUB_SECRET_KEY, STRIPE_CLUB_WEBHOOK_SECRET,
# GELATO_API_KEY, CLUB_ORDER_EMAIL y CLUB_EMAIL_FROM.
# Las funciones reutilizan también SMTP_HOSTNAME, SMTP_PORT, SMTP_SECURE,
# SMTP_USERNAME, SMTP_PASSWORD, SMTP_FROM y LATIDO_APP_URL.
