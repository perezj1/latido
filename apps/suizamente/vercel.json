    },
    {
      "source": "/proponer",
      "destination": "/proponer/index.html"
    },
    {
      "source": "/moderacion",
      "destination": "/moderacion/index.html"
    },
    {
      "source": "/avisos",
      "destination": "/avisos/index.html"
    },
    {
      "source": "/jugar",
      "destination": "/jugar/index.html"
    },
    {
      "source": "/duelo/:codigo([A-Fa-f0-9]{8})",
      "destination": "/duelo.html"
    },
    {
      "source": "/onboarding",
      "destination": "/onboarding/index.html"
    },
    {
      "source": "/conquista",
      "destination": "/conquista/index.html"
    },
    {
      "source": "/conquista/tienda",
