{
  "name": "suizamente",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --config vite.game.config.js --host 127.0.0.1 --port 5270",
    "build": "vite build --config vite.game.config.js",
    "preview": "vite preview --config vite.game.config.js --host 127.0.0.1 --port 5271",
    "lint": "eslint src test vite.config.js public/sw.js",
    "test": "node --test test/*.test.mjs",
    "test:build": "node test/build.mjs",
    "test:browser": "node test/browser.mjs",
    "test:onboarding": "node test/onboarding-browser.mjs",
    "test:install": "node test/install-browser.mjs",
    "test:social": "node test/social-browser.mjs",
    "test:retos": "node test/retos-browser.mjs",
    "test:conquista": "node test/conquista-browser.mjs",
    "test:accounts": "node scripts/test-suizamente-v14.mjs && node scripts/test-session-transport.mjs",
    "test:entry": "node scripts/test-suizamente-login-browser.mjs && node scripts/test-suizamente-entry-profile.mjs",
    "test:photos": "node scripts/test-suizamente-fotos.mjs",
    "test:avatars": "node scripts/test-suizamente-v18.mjs && node scripts/test-suizamente-v18-browser.mjs && node scripts/test-suizamente-v18-browser.mjs --webkit",
    "test:play": "node scripts/test-suizamente-play-browser.mjs && node scripts/test-suizamente-play-browser.mjs --webkit",
    "test:moments": "node scripts/test-suizamente-moments-browser.mjs && node scripts/test-suizamente-moments-browser.mjs --webkit",
    "test:ux": "node scripts/test-suizamente-ux-browser.mjs && node scripts/test-suizamente-ux-browser.mjs --webkit && node scripts/test-suizamente-delivery.mjs",
    "dev:qa": "node scripts/preview-suizamente.mjs --lan",
    "test:rules": "node scripts/test-suizamente-v17.mjs && node scripts/test-suizamente-v17-browser.mjs && node scripts/test-suizamente-v17-browser.mjs --webkit",
    "test:game": "node scripts/test-suizamente-production-browser.mjs",
    "test:independence": "node scripts/test-independencia.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.7",
    "@supabase/supabase-js": "^2.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "html-to-image": "^1.11.13",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.28.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.18.2",
    "run": "^1.5.0",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "vite": "7.3.6",
    "@vitejs/plugin-react": "^5.2.0"
  }
}
